# Production: non-secret values, committed. docs/environments.md
#
# NEVER put a secret here: the repository is public. Secrets live in the
# GitHub environment "production" (and .env.production.local for break-glass deploys).
# Every key becomes a plain-text Worker variable and NEXT_PUBLIC_* keys are
# baked into the browser bundle by `pnpm build:production`.
# A unit test fails if a declared secret name appears in this file.

APP_URL=https://openspotleague.com

# --- Supabase project pvnchrcczjnoubymrvzz (production) ---
NEXT_PUBLIC_SUPABASE_URL=https://pvnchrcczjnoubymrvzz.supabase.co
SUPABASE_URL=https://pvnchrcczjnoubymrvzz.supabase.co
# Publishable keys are public by design (they ship in the browser bundle).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=__SET_ME__ (Supabase production project → Settings → API keys → publishable)

# --- Media storage ---
STORAGE_PROVIDER=r2
R2_BUCKET_SPOTS=openspotleague-spots
R2_BUCKET_EVENTS=openspotleague-events
R2_PUBLIC_DOMAIN_SPOTS=spots.cdn.openspotleague.com
R2_PUBLIC_DOMAIN_EVENTS=events.cdn.openspotleague.com

# --- Database pool (per request; Hyperdrive pools the real connections) ---
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=8000

# --- External services ---
URL_WEATHER=https://api.openweathermap.org
URL_WEATHER_IMG=https://openweathermap.org/payload/api/media/file
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=openspot/1.0 (https://openspotleague.com)
EMERGENCY_API_URL=https://emergencynumberapi.com
EMERGENCY_USER_AGENT=openspot/1.0 (contact@openspotleague.com)

# --- Games ---
GAME_LOCATION_MAX_ACCURACY_METERS=250
GAME_LOCATION_VERIFICATION_TTL_SECONDS=900

# --- Support links (public pages) ---
NEXT_PUBLIC_PAYPAL_URL=https://www.paypal.com/ncp/payment/8XU46EVXHAVYL

# --- Build-time switches (move into src/lib/flags with the flag module) ---
NEXT_PUBLIC_MAP_DISTANCE=off
NEXT_PUBLIC_FEATURE_SHORT_LINKS=on
