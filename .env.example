# ===========================================================================
# OpenSpot Environment Configuration Template (.env.example)
#
# Copy this file to .env.local and populate the secrets for your environment:
#   cp .env.example .env.local
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Public Origin & Application Settings
# ---------------------------------------------------------------------------
# Public origin used by metadataBase, sitemap, robots, and canonical URLs.
# On Vercel, unset falls back to VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=https://openspotleague.com

# Map-page distance UI (spot pins, sidebar rows, search results).
# Anything other than "off" enables it. Set to "off" to hide distance labels.
NEXT_PUBLIC_MAP_DISTANCE=on

# Short links generation and client UI upgrade.
# Values: "on" | "off" (default: "off" during rollout phase).
NEXT_PUBLIC_FEATURE_SHORT_LINKS=off

# Optional support / creator links. Leave unset until public pages are active.
# NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/your-name
# NEXT_PUBLIC_PATREON_URL=https://patreon.com/your-name
# NEXT_PUBLIC_PAYPAL_URL=https://paypal.me/your-name

# ---------------------------------------------------------------------------
# 2. Weather Services (OpenWeather API)
# ---------------------------------------------------------------------------
URL_WEATHER=https://api.openweathermap.org
URL_WEATHER_IMG=https://openweathermap.org/payload/api/media/file
API_KEY_WEATHER=

# ---------------------------------------------------------------------------
# 3. Geocoding & Emergency Services
# ---------------------------------------------------------------------------
# Nominatim (OpenStreetMap geocoder). Requires descriptive User-Agent with contact.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=openspot/1.0 (contact@openspotleague.com)

# Emergency Numbers API (emergencynumberapi.com). No API key required.
EMERGENCY_API_URL=https://emergencynumberapi.com
EMERGENCY_USER_AGENT=openspot/1.0 (contact@openspotleague.com)

# ---------------------------------------------------------------------------
# 4. PostgreSQL / Supabase Database Connections
# ---------------------------------------------------------------------------
# SUPABASE_DATABASE_URL: Transaction mode pooler (port 6543).
# Required on Vercel and for serverless runtime.
# Format: postgres://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=

# SUPABASE_DIRECT_URL: Direct PostgreSQL connection (port 5432).
# Required for running DDL migrations locally (pnpm db:apply). Never set on Vercel.
# Format: postgres://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DIRECT_URL=

# Database pool controls (optional). Bounded defaults applied when omitted.
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=8000
# DB_MAX_LIFETIME_SECONDS=240
# DB_OPERATION_TIMEOUT_MS=15000
# DB_POOL_CHECKOUT_TIMEOUT_MS=3000
# DB_POOL_CHECKOUT_MAX_ATTEMPTS=3
# DB_CONCURRENCY_MAX=3

# ---------------------------------------------------------------------------
# 5. Supabase Auth & Service Credentials
# ---------------------------------------------------------------------------
# Browser-safe client keys (used by SSR client and Next.js proxy)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase endpoints and secret key (used for admin operations bypassing RLS)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Bootstrap admin accounts: CSV of user emails granted admin role during pnpm db:seed
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# 6. Challenge Games & Location Verification Policy
# ---------------------------------------------------------------------------
GAME_LOCATION_MAX_ACCURACY_METERS=250
GAME_LOCATION_VERIFICATION_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# 7. Media Storage (Cloudflare R2 / Supabase Storage)
# ---------------------------------------------------------------------------
# Storage provider plane: 'r2' (recommended) or 'supabase'
STORAGE_PROVIDER=r2

# Cloudflare R2 Credentials (when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_SPOTS=openspotleague-spots
R2_BUCKET_EVENTS=openspotleague-events
R2_PUBLIC_DOMAIN_SPOTS=spots.cdn.openspotleague.com
R2_PUBLIC_DOMAIN_EVENTS=events.cdn.openspotleague.com

# Supabase Storage Buckets (when STORAGE_PROVIDER=supabase)
# SUPABASE_STORAGE_BUCKET_SPOTS=spot-images
# SUPABASE_STORAGE_BUCKET_EVENTS=event-images
