{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-no-db",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://no-db:no-db@127.0.0.1:1/no-db?sslmode=disable",
        "pnpm",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-dummy-db",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SUPABASE_DATABASE_URL=",
        "SUPABASE_DIRECT_URL=",
        "DATABASE_URL=",
        "DB_CONNECTION_STRING=",
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54399/postgres",
        "pnpm",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54399/postgres",
        "pnpm", "start", "--port", "4173", "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "og-cards",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4178", "--bind", "127.0.0.1", "--directory", "design/og-cards"],
      "port": 4178
    }
  ]
}
