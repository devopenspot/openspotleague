{
  "name": "open-spot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm build:develop",
    "build:develop": "tsx scripts/build.ts develop",
    "build:production": "tsx scripts/build.ts production",
    "start": "vite preview --mode develop",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-tv": "tsx src/db/seed-tv.ts",
    "db:seed-tricks": "tsx src/db/seed-tricks.ts",
    "db:seed-tricks:skateboard": "tsx src/db/seed-tricks.ts skateboard",
    "db:seed-tricks:bmx": "tsx src/db/seed-tricks.ts bmx",
    "db:seed-tricks:scooter": "tsx src/db/seed-tricks.ts scooter",
    "db:seed-tricks:roller": "tsx src/db/seed-tricks.ts roller",
    "db:health": "tsx src/db/health-cli.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:verify-cdn": "tsx scripts/verify-cdn-assets.ts",
    "og:check": "tsx scripts/og-check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:verify-game-lifecycle": "tsx scripts/verify-challenge-game-lifecycle.ts",
    "db:check-pool": "tsx src/db/pool-check-cli.ts",
    "db:apply": "tsx src/db/apply-sql.ts",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "egress:snapshot": "tsx src/db/egress-snapshot.ts",
    "db:fresh": "pnpm db:reset && pnpm db:apply",
    "db:fresh:seed": "pnpm db:reset && pnpm db:apply && pnpm db:seed && pnpm db:seed-tv && pnpm db:seed-tricks",
    "db:migrate-spots": "tsx scripts/migrate-spots.ts",
    "db:curate-cities": "tsx scripts/curate-cities.ts",
    "deploy:develop": "tsx scripts/deploy.ts develop",
    "deploy:production": "tsx scripts/deploy.ts production",
    "aws:install": "pnpm --dir infra/aws install --ignore-workspace",
    "aws:typecheck": "pnpm --dir infra/aws exec tsc --noEmit",
    "aws:synth": "pnpm --dir infra/aws exec cdk synth",
    "aws:diff": "pnpm --dir infra/aws exec cdk diff",
    "aws:deploy": "pnpm --dir infra/aws exec cdk deploy"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@base-ui/react": "^1.9.0",
    "@cloudflare/workers-response-store": "^1.1.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@vinext/cloudflare": "^1.3.3",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "^16.4.5",
    "postcss": "^8.5.32",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-leaflet": "^5.0.0",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vinext": "^1.4.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-beta.28",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unidecode": "^1.1.0",
    "vite": "8.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
